{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nlibrary(maftools)\nlibrary(data.table)\nm1 <- read.maf('LLM_validation_input_file/cohort1.maf')\nm2 <- read.maf('LLM_validation_input_file/cohort2.maf')\ngenes <- unique(c(as.character(getGeneSummary(m1)[1:5, Hugo_Symbol]), as.character(getGeneSummary(m2)[1:5, Hugo_Symbol])))\ncat('requested_top_genes_union=', paste(genes, collapse=','), '\\\\n', sep='')\ndat1 <- subsetMaf(maf=m1, genes=genes, includeSyn=FALSE, mafObj=FALSE)\ndat2 <- subsetMaf(maf=m2, genes=genes, includeSyn=FALSE, mafObj=FALSE)\nif (\"'!'\"'t_vaf' %in% colnames(dat1)) dat1[, t_vaf := as.numeric(as.character(t_alt_count))/(as.numeric(as.character(t_ref_count))+as.numeric(as.character(t_alt_count)))]\nif (\"'!'\"'t_vaf' %in% colnames(dat2)) dat2[, t_vaf := as.numeric(as.character(t_alt_count))/(as.numeric(as.character(t_ref_count))+as.numeric(as.character(t_alt_count)))]\nif (max(dat1\"'$t_vaf, na.rm=TRUE) > 1) dat1$t_vaf <- dat1$t_vaf/100\nif (max(dat2$t_vaf, na.rm=TRUE) > 1) dat2$t_vaf <- dat2$t_vaf/100\nvafdat <- rbindlist(list(M1=dat1[,.(Hugo_Symbol,t_vaf)], M2=dat2[,.(Hugo_Symbol,t_vaf)]), idcol='\"'Cohort')\nvafdat[, Cohort := factor(Cohort, levels=c('M1','M2'), ordered=TRUE)]\nplot_genes <- vafdat[, .N, Hugo_Symbol][, Hugo_Symbol]\ncat('plot_gene_order=', paste(plot_genes, collapse=','), '\\\\n', sep='')\nres <- rbindlist(lapply(plot_genes, function(g) {\n  x <- vafdat[Hugo_Symbol == g]\n  p <- try(t.test(t_vaf ~ Cohort, data=x)\"'$p.value, silent=TRUE)\n  if (inherits(p, '\"'try-error')) p <- NA_real_\n  data.table(\n    Hugo_Symbol=g,\n    M1_n=x[Cohort=='M1', .N], M2_n=x[Cohort=='M2', .N],\n    M1_median=round(x[Cohort=='M1', median(t_vaf, na.rm=TRUE)], 6),\n    M2_median=round(x[Cohort=='M2', median(t_vaf, na.rm=TRUE)], 6),\n    ttest_p=signif(p, 6),\n    sig_label=ifelse(\"'!is.na(p) & p < 0.01, '\"'***', ifelse(\"'!is.na(p), '\"'ns', NA_character_))\n  )\n}))\nfwrite(res, 'LLM_validation_outputs/vaf_compare.deterministic_summary.tsv', sep='\\\\t')\nprint(res)\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
