{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' LLM_validation_outputs/exported_r_scripts/clinical_enrichment_brca_er_status_minmut5.R\"","aggregated_output":"# Auto-exported by Maftools-MCP export_r_script for validation.\n# This script was captured from the existing MCP tool implementation.\n# MCP tool: clinical_enrichment\n# Underlying R/Maftools function: maftools::clinicalEnrichment\n# Effective MCP parameters:\n#   maf_path = \"maftools_validation_data/LLM_Stage2_validation/LLM_validation_input_file/BRCA_clinical_enrichment_validation_subset.rds\"\n#   clinicalFeature = \"breast_carcinoma_estrogen_receptor_status\"\n#   clinicalData = null\n#   annotationDat = null\n#   minMut = 5\n#   useCNV = true\n#   pVal = 0.05\n#   cols = null\n#   annoFontSize = 0.8\n#   geneFontSize = 0.8\n#   legendFontSize = 0.8\n#   showTitle = true\n#   output_dir = \"maftools_validation_data/LLM_Stage2_validation/LLM_validation_outputs\"\n\nlibrary(maftools)\n\nmaf_obj <- readRDS(\"maftools_validation_data/LLM_Stage2_validation/LLM_validation_input_file/BRCA_clinical_enrichment_validation_subset.rds\")\n\n# ---- Attach clinical data if provided or missing ----\nif (!is.null(NULL)) {\n    clin <- NULL\n\n    # Try to ensure Tumor_Sample_Barcode column exists\n    if (!(\"Tumor_Sample_Barcode\" %in% colnames(clin))) {\n        colnames(clin)[1] <- \"Tumor_Sample_Barcode\"\n    }\n\n    maf_obj@clinical.data <- clin\n}\n\nif (is.null(maf_obj@clinical.data) || nrow(maf_obj@clinical.data) == 0) {\n    stop(\"No clinical data found in maf_obj@clinical.data. Provide an .rds MAF with clinical data or pass clinicalData table.\")\n}\n\nif (!(\"breast_carcinoma_estrogen_receptor_status\" %in% colnames(maf_obj@clinical.data))) {\n    stop(paste0(\"clinicalFeature not found in clinical.data: breast_carcinoma_estrogen_receptor_status. Available columns: \",\n                paste(colnames(maf_obj@clinical.data), collapse=\", \")))\n}\n\nenrich_res <- clinicalEnrichment(\n    maf = maf_obj,\n    clinicalFeature = \"breast_carcinoma_estrogen_receptor_status\",\n    annotationDat = NULL,\n    minMut = 5,\n    useCNV = TRUE\n)\n\nwrite.table(\n    enrich_res$groupwise_comparision,\n    file = \"maftools_validation_data/LLM_Stage2_validation/LLM_validation_outputs/clinical_enrichment_results.txt\",\n    sep = \"\\t\",\n    quote = FALSE,\n    row.names = FALSE\n)\n\npng(\"maftools_validation_data/LLM_Stage2_validation/LLM_validation_outputs/clinical_enrichment_plot.png\", width = 1800, height = 1400, res = 300)\n\nplotEnrichmentResults(\n    enrich_res = enrich_res,\n    pVal = 0.05,\n    cols = NULL,\n    annoFontSize = 0.8,\n    geneFontSize = 0.8,\n    legendFontSize = 0.8,\n    showTitle = TRUE\n)\n\ndev.off()\n","exit_code":0,"status":"completed"}}
