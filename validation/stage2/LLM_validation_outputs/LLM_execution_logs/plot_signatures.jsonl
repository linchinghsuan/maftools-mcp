{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' LLM_validation_outputs/exported_r_scripts/plot_signatures_no_contributions.R\"","aggregated_output":"# Auto-exported by Maftools-MCP export_r_script for validation.\n# This script was captured from the existing MCP tool implementation.\n# MCP tool: plot_signatures\n# Underlying R/Maftools function: maftools::plotSignatures\n# Effective MCP parameters:\n#   extractSignatures_rds = \"LLM_validation_outputs/extract_signatures__extractSignatures.rds\"\n#   contributions = false\n#   font_size = 1.2\n#   show_title = true\n#   sig_db = \"legacy\"\n#   axis_lwd = 2\n#   title_size = 0.9\n#   show_barcodes = false\n#   yaxisLim = 0.3\n#   output_dir = \"LLM_validation_outputs\"\n#   img_width = 2600\n#   img_height = 2000\n\nlibrary(maftools)\n\next <- readRDS(\"LLM_validation_outputs/extract_signatures__extractSignatures.rds\")\n\npng(\"maftools_validation_data/LLM_Stage2_validation/LLM_validation_input_file/LLM_validation_outputs/signature_profiles.png\", width=2600, height=2000, res=300)\nplotSignatures(\n    nmfRes = ext,\n    contributions = FALSE,\n    font_size = 1.2,\n    show_title = TRUE,\n    sig_db = \"legacy\",\n    axis_lwd = 2,\n    title_size = 0.9,\n    show_barcodes = FALSE,\n    yaxisLim = 0.3\n)\ndev.off()\n","exit_code":0,"status":"completed"}}
