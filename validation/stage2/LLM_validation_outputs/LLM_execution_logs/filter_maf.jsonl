{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nmcp <- read.delim('LLM_validation_outputs/filtered_maf.mcp.tsv', sep='\\\\t', check.names=FALSE, stringsAsFactors=FALSE)\ndir <- read.delim('LLM_validation_outputs/filtered_maf.direct_r.tsv', sep='\\\\t', check.names=FALSE, stringsAsFactors=FALSE)\nkey_cols <- c('Hugo_Symbol','Chromosome','Start_Position','End_Position','Variant_Classification','Variant_Type','Tumor_Sample_Barcode')\nkey_cols <- key_cols[key_cols %in% names(mcp) & key_cols %in% names(dir)]\nmd5s <- tools::md5sum(c('LLM_validation_outputs/filtered_maf.mcp.tsv', 'LLM_validation_outputs/filtered_maf.direct_r.tsv'))\nlines <- c(\n  'filter_maf default gene-filter validation comparison',\n  paste('MCP rows:', nrow(mcp)),\n  paste('Direct R rows:', nrow(dir)),\n  paste('MCP columns:', ncol(mcp)),\n  paste('Direct R columns:', ncol(dir)),\n  paste('Column names identical:', identical(names(mcp), names(dir))),\n  paste('Key columns:', paste(key_cols, collapse=', ')),\n  paste('Key-column values identical:', identical(mcp[key_cols], dir[key_cols])),\n  paste('Full table identical:', identical(mcp, dir)),\n  paste('Unique genes MCP:', length(unique(mcp\"'$Hugo_Symbol))),\n  paste('\"'Unique genes Direct R:', length(unique(dir\"'$Hugo_Symbol))),\n  paste('\"'Unique samples MCP:', length(unique(mcp\"'$Tumor_Sample_Barcode))),\n  paste('\"'Unique samples Direct R:', length(unique(dir\"'$Tumor_Sample_Barcode))),\n  paste('\"'MCP TSV MD5:', unname(md5s[1])),\n  paste('Direct R TSV MD5:', unname(md5s[2]))\n)\nwriteLines(lines, 'LLM_validation_outputs/filter_maf.comparison.txt')\nRS\nsed -n '1,80p' LLM_validation_outputs/filter_maf.comparison.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
